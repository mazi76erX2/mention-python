# Mention API Configuration
# Copy this file to .env and fill in your values

# Required: Your Mention API access token
MENTION_ACCESS_TOKEN=your-access-token-here

# Optional: Default account ID
MENTION_ACCOUNT_ID=your-account-id

# Optional: API base URL (default: https://api.mention.net/api)
# MENTION_BASE_URL=https://api.mention.net/api

# Optional: Request timeout in seconds (default: 30)
# MENTION_TIMEOUT=30

# Optional: Maximum retry attempts (default: 3)
# MENTION_MAX_RETRIES=3

# Optional: Delay between retries in seconds (default: 1.0)
# MENTION_RETRY_DELAY=1.0